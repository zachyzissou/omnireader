POSTGRES_PASSWORD=changeme_secure_password
N8N_USER=admin
N8N_PASSWORD=changeme_n8n_password

# Brain service configuration
DATABASE_URL=postgresql://omnireader:changeme_secure_password@localhost:5432/omnireader
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAI API key for embeddings (optional)

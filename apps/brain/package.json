{
  "name": "@omnireader/brain",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "zod": "^3.24.1",
    "bullmq": "^5.34.5",
    "redis": "^4.7.0",
    "pg": "^8.11.3",
    "openai": "^4.71.1",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^26.0.0",
    "node-cron": "^3.0.3",
    "winston": "^3.17.0",
    "@bull-board/api": "^6.5.1",
    "@bull-board/express": "^6.5.1"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.11.10",
    "@types/jsdom": "^21.1.7",
    "@types/node-cron": "^3.0.11",
    "vitest": "^2.1.0"
  }
}